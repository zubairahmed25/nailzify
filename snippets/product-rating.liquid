{%- doc -%}
  Renders product ratings with visual stars, numeric values, and review counts using Shopify review metafields.

  Displays customer ratings using a 5-star system with half-star precision, numeric rating values, and total review counts. Integrates with Shopify's native review metafields and provides responsive layouts with proper accessibility support.

  @param {object} product - Product with review metafields
  @param {object} [block] - Section block for display variations
  @param {string} [class] - Additional CSS classes

  @example
  {% render 'product-rating', product: product %}
{%- enddoc -%}

{%- liquid
  assign rating_value = product.metafields.reviews.rating.value.rating
  assign rating_max = product.metafields.reviews.rating.value.scale_max | default: 5
  assign rating_count = product.metafields.reviews.rating_count.value

  if rating_value == blank
    assign rating_value = product.metafields.loox.avg_rating.value | default: product.metafields.loox.avg_rating
    assign rating_count = product.metafields.loox.num_reviews.value | default: product.metafields.loox.num_reviews
    assign rating_max = 5
  endif

  assign rating_value = rating_value | plus: 0
  assign rating_count = rating_count | plus: 0
  assign rating_display = rating_value | round: 1
  assign rating_decimal = 0
  assign decimal = rating_value | modulo: 1
  if decimal >= 0.3 and decimal <= 0.7
    assign rating_decimal = 0.5
  elsif decimal > 0.7
    assign rating_decimal = 1
  endif
-%}

{%- if rating_value > 0 and rating_count > 0 -%}
  <div class="product__rating flex items-center gap-2 {{ class }}" {{ block.shopify_attributes }}>
    <div
      class="rating text-lg leading-none"
      role="img"
      aria-label="{{ 'general.accessibility.star_reviews_info' | t: rating_value: rating_display, rating_max: rating_max }}"
    >
      <span
        aria-hidden="true"
        class="rating-star"
        style="--rating: {{ rating_value | floor }};--rating-max: {{ rating_max }};--rating-decimal: {{ rating_decimal }};"
      ></span>
    </div>
    <p class="rating-text text-sm leading-none">
      <span aria-hidden="true">{{ rating_display }}</span>
    </p>
    <p class="rating-count text-sm leading-none">
      <span aria-hidden="true">{{ 'general.accessibility.star_reviews_count' | t: count: rating_count }}</span>
      <span class="sr-only">
        {{- rating_count }}
        {{ 'general.accessibility.total_reviews' | t -}}
      </span>
    </p>
  </div>
{%- endif -%}
