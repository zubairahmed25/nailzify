{%- doc -%}
  Renders the compact Nailzify product benefit grid.

  @param {object} block - Product section block with editable labels
{%- enddoc -%}

<section class="nailzify-highlights" aria-labelledby="NailzifyHighlights-{{ block.id }}" {{ block.shopify_attributes }}>
  <p id="NailzifyHighlights-{{ block.id }}" class="nailzify-highlights__heading">
    {{- block.settings.heading | escape -}}
  </p>
  <ul class="nailzify-highlights__grid" role="list">
    <li class="nailzify-highlights__item">
      <svg class="nailzify-highlights__icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M16 3.5 18.8 10l6.7 2.8-6.7 2.8L16 22l-2.8-6.4-6.7-2.8 6.7-2.8L16 3.5Z"/>
        <path d="m24.5 20 1.2 2.8 2.8 1.2-2.8 1.2-1.2 2.8-1.2-2.8-2.8-1.2 2.8-1.2 1.2-2.8Z"/>
      </svg>
      <span>{{ block.settings.salon_quality | escape }}</span>
    </li>
    <li class="nailzify-highlights__item">
      <svg class="nailzify-highlights__icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M7 28V5"/>
        <path d="M7 6h17l-3.5 5L24 16H7"/>
        <path d="M11 9.5h7M11 12.5h5"/>
      </svg>
      <span>{{ block.settings.designed_in_usa | escape }}</span>
    </li>
    <li class="nailzify-highlights__item">
      <svg class="nailzify-highlights__icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="17" r="10"/>
        <path d="M16 11v6l4 2M12 3h8M16 3v4"/>
      </svg>
      <span>{{ block.settings.quick_application | escape }}</span>
    </li>
    <li class="nailzify-highlights__item">
      <svg class="nailzify-highlights__icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M16 27.5S6 22 6 13.8C6 9.9 8.7 7 12.2 7c2 0 3.2 1 3.8 2 .6-1 1.8-2 3.8-2C23.3 7 26 9.9 26 13.8 26 22 16 27.5 16 27.5Z"/>
        <path d="m23.5 3 .8 1.8 1.7.7-1.7.8-.8 1.7-.8-1.7-1.7-.8 1.7-.7.8-1.8Z"/>
      </svg>
      <span>{{ block.settings.woman_owned | escape }}</span>
    </li>
  </ul>
</section>
