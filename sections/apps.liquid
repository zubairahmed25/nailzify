<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }
</style>

{%- liquid
  assign nailzify_product_reviews = section.settings.nailzify_product_reviews
  assign nailzify_home_reviews = section.settings.nailzify_home_reviews
  assign nailzify_review_eyebrow = section.settings.review_eyebrow
  assign nailzify_review_heading = section.settings.review_heading
  assign nailzify_review_intro = section.settings.review_intro

  if request.page_type == 'index' and section.id contains '1757225448cbccf3ce'
    assign nailzify_home_reviews = true
    assign nailzify_review_eyebrow = 'Community spotlight'
    assign nailzify_review_heading = 'Nailzify in motion.'
    assign nailzify_review_intro = 'Real sets, real routines, and the looks our community keeps reaching for.'
  elsif request.page_type == 'index' and section.id contains '17566891356766e5dd'
    assign nailzify_home_reviews = true
    assign nailzify_review_eyebrow = 'Customer love'
    assign nailzify_review_heading = 'Real nails. Real reviews.'
    assign nailzify_review_intro = 'Honest feedback from the Nailzify community, from first application to everyday wear.'
  endif

  assign nailzify_reviews_style = false
  if nailzify_product_reviews or nailzify_home_reviews
    assign nailzify_reviews_style = true
  endif
-%}
<div class="section section--padding{% if nailzify_reviews_style %} nailzify-reviews{% endif %}{% if nailzify_product_reviews %} nailzify-product-reviews{% endif %}{% if nailzify_home_reviews %} nailzify-home-reviews{% endif %}{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
    {%- if nailzify_reviews_style -%}
      <header class="nailzify-section-heading nailzify-product-reviews__heading">
        {%- if nailzify_review_eyebrow != blank -%}
          <p class="nailzify-section-heading__eyebrow">{{ nailzify_review_eyebrow | escape }}</p>
        {%- endif -%}
        {%- if nailzify_review_heading != blank -%}
          <h2 class="nailzify-section-heading__title">{{ nailzify_review_heading | escape }}</h2>
        {%- endif -%}
        {%- if nailzify_review_intro != blank -%}
          <p class="nailzify-section-heading__intro">{{ nailzify_review_intro | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.apps.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "color",
      "id": "color_highlight",
      "label": "t:sections.global.settings.color_highlight.label"
    },
    {
      "type": "color_background",
      "id": "gradient_highlight",
      "label": "t:sections.global.settings.gradient_highlight.label"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "t:sections.global.settings.color_button_text.label"
    },
    {
      "type": "color",
      "id": "color_button_background",
      "label": "t:sections.global.settings.color_button_background.label"
    },
    {
      "type": "color_background",
      "id": "color_button_gradient",
      "label": "t:sections.global.settings.color_button_gradient.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "checkbox",
      "id": "nailzify_product_reviews",
      "label": "Use Nailzify product review styling",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "nailzify_home_reviews",
      "label": "Use Nailzify homepage review styling",
      "default": false
    },
    {
      "type": "text",
      "id": "review_eyebrow",
      "label": "Review eyebrow",
      "default": "Customer love"
    },
    {
      "type": "text",
      "id": "review_heading",
      "label": "Review heading",
      "default": "Real nails. Real reviews."
    },
    {
      "type": "text",
      "id": "review_intro",
      "label": "Review introduction",
      "default": "See how Nailzify fits into real routines, from application to everyday wear."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 72
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.global.settings.divider.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.global.settings.full_width.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": false,
      "label": "t:sections.global.settings.rounded.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.apps.name"
    }
  ],
  "disabled_on": {
    "groups": [
      "custom.overlay"
    ]
  }
}
{% endschema %}
