<style>
    .collection__suit
    {
        width:100%;
        box-sizing:border-box;
        display:block; 
        margin:40px 0;
        overflow:hidden;
    }
    .collection__suit h3
    {
      position:absolute;
      width:1px;
      height:1px;
      padding:0;
      margin:-1px;
      overflow:hidden;
      clip:rect(0, 0, 0, 0);
      white-space:nowrap;
      border:0;
    }

    @media (max-width: 768px) {
 .collection__suit ul
    {
         width:100%;
        display:flex;
        justify-content:flex-start !important;
        gap:24px !important;
        overflow-x:auto;
    }
    .collection__suit {
      margin:24px 0 !important;
      padding-inline:20px;
      overflow:hidden !important;
}


}

    .collection__suit ul
    {
         width:100%;
        display:flex;
        justify-content:center;
        gap:30px;
        overflow-x:auto;
    }
    .collection__suit ul li
    {
        width:auto;
        display:block;
    }
    .collection__suit ul li a
    {
        width:100px;
        display:block;
        text-align:center; 
    }
     .collection__suit ul li a span
    {
        width:120px; 
        height:120px; 
        border-radius:50%;
        display:flex;
        background-size:cover; 
        background-position:center; 
        display:block; 
        margin:0 auto;
    }
    .collection__suit ul li a b
    {
        width:auto;
        display:block;
        color:#802d44;
        padding-top:10px;
    }
</style>


<div class="collection__suit">  
  {% assign suit_collections = collection.metafields.custom.collection_suit.value %} 
  <h3>{{ collection.title }}</h3>

  {% if suit_collections != blank %}
    <ul>
      {% for suit_collection in suit_collections %}
        {% assign current_title = suit_collection.title %}
        {% assign parent_title = collection.title %}

        <li>
          <a href="{{ suit_collection.url }}">
            <span 
              style="background-image:url({{ suit_collection.image | img_url: 'master' }}); 
                     {% if current_title == parent_title %}border:2px solid #a64862;{% endif %}">
            </span>
            <b>{{ suit_collection.title }}</b> 
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %} 
</div>


{% schema %}
{
  "name": "Collection Suit", 
  "settings": [],
  "blocks": [], 
  "presets": [
    {
      "name": "Collection Suit"
    }
  ]
}
{% endschema %}
 
