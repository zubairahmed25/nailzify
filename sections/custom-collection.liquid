<style>
    .collection__suit
    {
        width:100%;
        box-sizing:border-box;
        display:block; 
        margin:40px 0;
        overflow:hidden;
    }
    .collection__suit h3
    {
      position:absolute;
      width:1px;
      height:1px;
      padding:0;
      margin:-1px;
      overflow:hidden;
      clip:rect(0, 0, 0, 0);
      white-space:nowrap;
      border:0;
    }

    @media (max-width: 768px) {
 .collection__suit ul
    {
         width:100%;
        display:flex;
        justify-content:flex-start !important;
        gap:24px !important;
        overflow-x:auto;
    }
    .collection__suit {
      margin:24px 0 !important;
      padding-inline:20px;
      overflow:hidden !important;
}


}

    .collection__suit ul
    {
         width:100%;
        display:flex;
        justify-content:center;
        gap:30px;
        overflow-x:auto;
    }
    .collection__suit ul li
    {
        width:auto;
        display:block;
    }
    .collection__suit ul li a
    {
        width:120px;
        display:block;
        text-align:center; 
    }
     .collection__suit ul li a span
    {
        width:120px; 
        height:120px; 
        border-radius:50%;
        display:flex;
        display:block; 
        margin:0 auto;
    }
    .collection__suit ul li a[aria-current="page"] span
    {
        border:2px solid rgb(var(--nz-color-accent));
    }
    .collection__suit__image
    {
        display:block;
        width:100%;
        height:100%;
        object-fit:cover;
        border-radius:inherit;
    }
    .collection__suit__image--shape
    {
        object-fit:contain;
        padding:var(--sp-2d5);
    }
    .collection__suit ul li a b
    {
        width:auto;
        display:block;
        color:#802d44;
        padding-top:10px;
    }
</style>


<div class="collection__suit">  
  {% assign suit_collections = collection.metafields.custom.collection_suit.value %} 
  <h3>{{ collection.title }}</h3>

  {% if suit_collections != blank %}
    <ul>
      {% for suit_collection in suit_collections %}
        {% liquid
          assign shape_asset = blank
          case suit_collection.handle
            when 'ballerina-coffin'
              assign shape_asset = 'nailzify-shape-coffin.webp'
            when 'short-oval'
              assign shape_asset = 'nailzify-shape-short-oval.webp'
            when 'almond'
              assign shape_asset = 'nailzify-shape-almond.webp'
            when 'short-square'
              assign shape_asset = 'nailzify-shape-short-square.webp'
          endcase
        %}

        <li>
          <a href="{{ suit_collection.url }}"{% if suit_collection.id == collection.id %} aria-current="page"{% endif %}>
            <span>
              {% if shape_asset != blank %}
                <img class="collection__suit__image collection__suit__image--shape" src="{{ shape_asset | asset_url }}" alt="" width="512" height="512" loading="eager" decoding="async">
              {% elsif suit_collection.image != blank %}
                {{ suit_collection.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,240', sizes: '120px', alt: '', class: 'collection__suit__image' }}
              {% endif %}
            </span>
            <b>{{ suit_collection.title }}</b> 
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %} 
</div>


{% schema %}
{
  "name": "Collection Suit", 
  "settings": [],
  "blocks": [], 
  "presets": [
    {
      "name": "Collection Suit"
    }
  ]
}
{% endschema %}
 
