{{ 'nailzify-holiday-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nailzify-holiday-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign card_count = section.blocks.size
  assign mobile_hero_index = section.settings.mobile_hero_card | plus: 0
  assign mobile_slide_count = 0
  assign mobile_selected_block_id = blank

  if mobile_hero_index < 1 or mobile_hero_index > card_count
    assign mobile_hero_index = 1
  endif

  if section.settings.enable_mobile_hand_slider
    for block in section.blocks
      if block.settings.show_in_mobile_slider
        if block.settings.mobile_slider_image != blank or block.settings.mobile_slider_fallback != 'none'
          assign mobile_slide_count = mobile_slide_count | plus: 1

          if forloop.index == mobile_hero_index
            assign mobile_selected_block_id = block.id
          endif
        endif
      endif
    endfor

    if mobile_selected_block_id == blank
      for block in section.blocks
        if block.settings.show_in_mobile_slider
          if block.settings.mobile_slider_image != blank or block.settings.mobile_slider_fallback != 'none'
            assign mobile_selected_block_id = block.id
            break
          endif
        endif
      endfor
    endif
  endif

  assign heading_tag = section.settings.heading_tag
  assign heading_text = section.settings.heading | strip
  assign cyrene_supporting_text = 'Your finishing touch for every celebration.'
  assign use_cyrene_supporting_artwork = false

  if section.settings.supporting_text == cyrene_supporting_text
    assign use_cyrene_supporting_artwork = true
  endif

  capture heading_artwork_url
    if section.settings.heading_artwork != blank
      echo section.settings.heading_artwork | image_url: width: 1800
    else
      echo 'nailzify-holiday-heading.png' | asset_url
    endif
  endcapture
  assign heading_artwork_url = heading_artwork_url | strip

  capture mobile_slider_background_url
    if section.settings.mobile_slider_background_image != blank
      echo section.settings.mobile_slider_background_image | image_url: width: 1800
    else
      echo 'nailzify-holiday-mobile-background.webp' | asset_url
    endif
  endcapture
  assign mobile_slider_background_url = mobile_slider_background_url | strip
-%}

<style>
  #shopify-section-{{ section.id }} {
    --holiday-background: {{ section.settings.color_background.rgb }};
    --holiday-text: {{ section.settings.color_text.rgb }};
    --holiday-supporting-text: {{ section.settings.color_supporting_text.rgb }};
    --holiday-accent: {{ section.settings.color_accent.rgb }};
    --holiday-button-background: {{ section.settings.color_button_background.rgb }};
    --holiday-button-text: {{ section.settings.color_button_text.rgb }};
    --holiday-card-background: {{ section.settings.color_card_background.rgb }};
    --holiday-section-background: {{ section.settings.color_section_background.rgb }};
    --holiday-min-height: {{ section.settings.min_height }}px;
    --holiday-heading-width: {{ section.settings.heading_width }}px;
    --holiday-heading-size: {{ section.settings.heading_size }}px;
    --holiday-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --holiday-card-height: {{ section.settings.card_height }}px;
    --holiday-card-height-mobile: {{ section.settings.card_height_mobile }}px;
    --holiday-mobile-poster-height: {{ section.settings.mobile_poster_height }}px;
    --holiday-mobile-text: {{ section.settings.color_mobile_text.rgb }};
    --holiday-mobile-button-background: {{ section.settings.color_mobile_button_background.rgb }};
    --holiday-mobile-button-text: {{ section.settings.color_mobile_button_text.rgb }};
    --holiday-mobile-overlay: {{ section.settings.color_mobile_overlay.rgb }};
    --holiday-mobile-overlay-opacity: {{ section.settings.mobile_overlay_opacity | divided_by: 100.0 }};
    --holiday-mobile-slider-background: {{ section.settings.color_mobile_slider_background.rgb }};
    --holiday-mobile-slider-background-image: url('{{ mobile_slider_background_url }}');
    --holiday-padding-top: {{ section.settings.padding_top }}px;
    --holiday-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<section
  class="nailzify-holiday-header-section{% if section.settings.enable_desktop_hand_slider and section.settings.enable_mobile_hand_slider and mobile_slide_count > 0 %} nailzify-holiday-header-section--desktop-poster{% endif %}"
  {% if heading_text != blank %}aria-labelledby="HolidayHeading-{{ section.id }}"{% endif %}
>
  <div class="nailzify-holiday-header__container page-width">
    <div
      class="nailzify-holiday-header nailzify-holiday-header--content-{{ section.settings.content_position }} nailzify-holiday-header--desktop-{{ section.settings.text_alignment }} nailzify-holiday-header--mobile-{{ section.settings.text_alignment_mobile }}{% if section.settings.rounded %} nailzify-holiday-header--rounded{% endif %}{% if card_count > 3 %} nailzify-holiday-header--many{% endif %}{% if section.settings.enable_mobile_hand_slider and mobile_slide_count > 0 %} nailzify-holiday-header--mobile-hand-slider{% endif %}"
      style="--holiday-card-count: {{ card_count | at_least: 1 }}; --holiday-mobile-card-count: {{ card_count | at_most: 2 | at_least: 1 }};"
    >
      {%- if section.settings.show_decorative_line -%}
        <span class="nailzify-holiday-header__line nailzify-holiday-header__line--top" aria-hidden="true"></span>
        <span class="nailzify-holiday-header__line nailzify-holiday-header__line--bottom" aria-hidden="true"></span>
      {%- endif -%}

      {%- if section.settings.show_sparkle -%}
        <svg class="nailzify-holiday-header__sparkle" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <path d="M16 0c.8 9.9 6.1 15.2 16 16-9.9.8-15.2 6.1-16 16C15.2 22.1 9.9 16.8 0 16 9.9 15.2 15.2 9.9 16 0Z" fill="currentColor"/>
        </svg>
      {%- endif -%}

      <div class="nailzify-holiday-header__content">
        {%- if section.settings.mobile_eyebrow != blank -%}
          <p class="nailzify-holiday-header__mobile-eyebrow">{{ section.settings.mobile_eyebrow | escape }}</p>
        {%- endif -%}

        {%- if heading_text != blank -%}
          {%- if section.settings.use_script_artwork -%}
            <{{ heading_tag }} class="sr-only" id="HolidayHeading-{{ section.id }}">{{ heading_text | escape }}</{{ heading_tag }}>
            <span
              class="nailzify-holiday-header__heading-artwork"
              style="--holiday-heading-artwork: url('{{ heading_artwork_url }}');"
              aria-hidden="true"
            ></span>
          {%- else -%}
            <{{ heading_tag }} class="nailzify-holiday-header__heading" id="HolidayHeading-{{ section.id }}">
              {{- heading_text | escape | newline_to_br -}}
            </{{ heading_tag }}>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.supporting_text != blank -%}
          {%- if use_cyrene_supporting_artwork -%}
            <p class="nailzify-holiday-header__supporting-text nailzify-holiday-header__supporting-text--artwork">
              <span class="sr-only">{{ section.settings.supporting_text | escape }}</span>
              <span
                class="nailzify-holiday-header__supporting-artwork"
                style="--holiday-supporting-artwork: url('{{ 'nailzify-cyrene-supporting.png' | asset_url }}');"
                aria-hidden="true"
              ></span>
            </p>
          {%- else -%}
            <p class="nailzify-holiday-header__supporting-text">{{ section.settings.supporting_text | escape }}</p>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          {%- if section.settings.button_link != blank -%}
            <a
              class="nailzify-holiday-header__button nailzify-holiday-header__button--{{ section.settings.button_style }}"
              href="{{ section.settings.button_link }}"
              {% if section.settings.button_external %}target="_blank" rel="noopener"{% endif %}
            >
              {{- section.settings.button_label | escape -}}
            </a>
          {%- else -%}
            <span class="nailzify-holiday-header__button nailzify-holiday-header__button--{{ section.settings.button_style }}" aria-disabled="true">
              {{- section.settings.button_label | escape -}}
            </span>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if section.settings.enable_mobile_hand_slider and mobile_slide_count > 0 -%}
        <div
          class="nailzify-holiday-header__mobile-slider"
          data-holiday-hand-slider
          data-desktop-enabled="{{ section.settings.enable_desktop_hand_slider }}"
          data-autoplay="{{ section.settings.mobile_slider_autoplay }}"
          data-delay="{{ section.settings.mobile_slider_delay | times: 1000 }}"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ section.settings.gallery_label | escape }}"
        >
          <div class="nailzify-holiday-header__mobile-slider-track" aria-live="off">
            {%- assign mobile_slide_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.show_in_mobile_slider -%}
                {%- liquid
                  assign mobile_hand_image = block.settings.mobile_slider_image
                  assign mobile_hand_fallback = block.settings.mobile_slider_fallback
                  assign mobile_hand_alt = block.settings.mobile_slider_alt | default: block.settings.alt_text | default: mobile_hand_image.alt
                  assign mobile_hand_label = block.settings.mobile_slider_label | default: block.settings.mobile_label
                  assign mobile_slide_active = false

                  if block.id == mobile_selected_block_id
                    assign mobile_slide_active = true
                  endif

                  if mobile_hand_alt == blank
                    assign mobile_hand_alt = block.settings.mobile_label | strip_newlines
                  endif

                  if section.index == 1 and mobile_slide_active
                    assign mobile_hand_loading = 'eager'
                  else
                    assign mobile_hand_loading = 'lazy'
                  endif
                -%}

                {%- if mobile_hand_image != blank or mobile_hand_fallback != 'none' -%}
                  <a
                    class="nailzify-holiday-header__mobile-slide{% if mobile_slide_active %} is-active{% endif %}"
                    href="{{ block.settings.mobile_slider_link | default: block.settings.link | default: section.settings.button_link }}"
                    data-holiday-hand-slide
                    data-slide-index="{{ mobile_slide_index }}"
                    data-slide-order="{{ block.settings.mobile_slider_order | default: 1 }}"
                    data-slide-label="{{ mobile_hand_alt | escape }}"
                    aria-hidden="{% if mobile_slide_active %}false{% else %}true{% endif %}"
                    {% unless mobile_slide_active %}tabindex="-1"{% endunless %}
                    style="--holiday-hand-position: {{ block.settings.mobile_slider_position }}; --holiday-hand-fit: {{ block.settings.mobile_slider_fit }}; --holiday-hand-scale: {{ block.settings.mobile_slider_scale | divided_by: 100.0 }}; --holiday-hand-offset-y: {{ block.settings.mobile_slider_offset_y | default: 0 }}px; --holiday-desktop-hand-scale: {{ block.settings.desktop_slider_scale | default: 100 | divided_by: 100.0 }}; --holiday-desktop-hand-offset-y: {{ block.settings.desktop_slider_offset_y | default: 0 }}px;"
                  >
                    {%- if mobile_hand_image != blank -%}
                      {{- mobile_hand_image
                        | image_url: width: 1400
                        | image_tag:
                          loading: mobile_hand_loading,
                          widths: '540,720,900,1120,1400',
                          sizes: '100vw',
                          alt: mobile_hand_alt,
                          class: 'nailzify-holiday-header__mobile-hand'
                      -}}
                    {%- elsif mobile_hand_fallback == 'polka' -%}
                      <img
                        class="nailzify-holiday-header__mobile-hand"
                        src="{{ 'nailzify-holiday-polka-hands.webp' | asset_url }}"
                        width="1023"
                        height="1537"
                        loading="{{ mobile_hand_loading }}"
                        alt="{{ mobile_hand_alt | escape }}"
                      >
                    {%- elsif mobile_hand_fallback == 'chrome' -%}
                      <img
                        class="nailzify-holiday-header__mobile-hand"
                        src="{{ 'nailzify-holiday-chrome-ivory-hands.webp' | asset_url }}"
                        width="1254"
                        height="1254"
                        loading="{{ mobile_hand_loading }}"
                        alt="{{ mobile_hand_alt | escape }}"
                      >
                    {%- elsif mobile_hand_fallback == 'snowflake' -%}
                      <img
                        class="nailzify-holiday-header__mobile-hand"
                        src="{{ 'nailzify-holiday-snowflake-mauve-hands.webp' | asset_url }}"
                        width="941"
                        height="1672"
                        loading="{{ mobile_hand_loading }}"
                        alt="{{ mobile_hand_alt | escape }}"
                      >
                    {%- endif -%}

                    {%- if mobile_hand_label != blank -%}
                      <span class="nailzify-holiday-header__mobile-label">
                        {{- mobile_hand_label | escape | newline_to_br -}}
                      </span>
                    {%- endif -%}
                  </a>

                  {%- assign mobile_slide_index = mobile_slide_index | plus: 1 -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if mobile_slide_count > 1 -%}
            <div class="nailzify-holiday-header__mobile-slider-controls" aria-label="Choose a nail design">
              {%- assign mobile_control_index = 0 -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign mobile_control_available = false

                  if block.settings.show_in_mobile_slider
                    if block.settings.mobile_slider_image != blank or block.settings.mobile_slider_fallback != 'none'
                      assign mobile_control_available = true
                    endif
                  endif
                -%}
                {%- if mobile_control_available -%}
                  <button
                    class="nailzify-holiday-header__mobile-slider-dot{% if block.id == mobile_selected_block_id %} is-active{% endif %}"
                    type="button"
                    data-holiday-hand-control="{{ mobile_control_index }}"
                    data-slide-order="{{ block.settings.mobile_slider_order | default: 1 }}"
                    aria-label="Show {{ block.settings.mobile_slider_alt | default: block.settings.alt_text | default: block.settings.mobile_label | strip_newlines | downcase | escape }}"
                    aria-current="{% if block.id == mobile_selected_block_id %}true{% else %}false{% endif %}"
                  >
                    <span aria-hidden="true"></span>
                  </button>
                  {%- assign mobile_control_index = mobile_control_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <p class="sr-only" data-holiday-hand-status aria-live="polite" aria-atomic="true"></p>
        </div>
      {%- endif -%}

      {%- if card_count > 0 -%}
        <div class="nailzify-holiday-header__gallery" role="list" aria-label="{{ section.settings.gallery_label | escape }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_image = block.settings.image
              assign mobile_image = block.settings.image_mobile | default: card_image
              assign card_alt = block.settings.alt_text | default: card_image.alt
              assign mobile_image_position = block.settings.image_position_mobile | default: block.settings.image_position
              assign fallback_asset = blank
              assign fallback_mobile_asset = blank
              assign fallback_width = 1200
              assign fallback_height = 1500

              case forloop.index
                when 1
                  assign fallback_asset = 'nailzify-holiday-cranberry.webp'
                  assign fallback_width = 2048
                  assign fallback_height = 2048
                when 2
                  assign fallback_asset = 'nailzify-holiday-chrome.jpg'
                  assign fallback_width = 1121
                  assign fallback_height = 1403
                when 3
                  assign fallback_asset = 'nailzify-holiday-polka-macro.webp'
                  assign fallback_mobile_asset = 'nailzify-holiday-polka.jpg'
                  assign fallback_width = 1254
                  assign fallback_height = 1254
              endcase

              if section.index == 1
                assign image_loading = 'eager'
              else
                assign image_loading = 'lazy'
              endif
            -%}

            <div
              class="nailzify-holiday-header__card-wrap{% if forloop.index == mobile_hero_index %} nailzify-holiday-header__card-wrap--mobile-hero{% endif %}"
              role="listitem"
              style="--holiday-image-position: {{ block.settings.image_position }}; --holiday-image-position-mobile: {{ mobile_image_position }};"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.link != blank -%}
                <a class="nailzify-holiday-header__card-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.link_label | default: card_alt | escape }}">
              {%- endif -%}

              <figure class="nailzify-holiday-header__card nailzify-holiday-header__card--{{ block.settings.image_fit }}">
                {%- if card_image != blank -%}
                  <picture>
                    {%- if block.settings.image_mobile != blank -%}
                      <source
                        media="(max-width: 767px)"
                        srcset="{{ mobile_image | image_url: width: 360 }} 360w, {{ mobile_image | image_url: width: 540 }} 540w, {{ mobile_image | image_url: width: 720 }} 720w"
                        width="{{ mobile_image.width }}"
                        height="{{ mobile_image.height }}"
                      >
                    {%- endif -%}
                    {{- card_image
                      | image_url: width: 1000
                      | image_tag:
                        loading: image_loading,
                        widths: '240,360,480,600,720,900,1000',
                        sizes: '(max-width: 767px) 100vw, 21vw',
                        alt: card_alt,
                        class: 'nailzify-holiday-header__image'
                    -}}
                  </picture>
                {%- elsif fallback_asset != blank -%}
                  <picture>
                    {%- if fallback_mobile_asset != blank -%}
                      <source media="(max-width: 767px)" srcset="{{ fallback_mobile_asset | asset_url }}">
                    {%- endif -%}
                    <img
                      class="nailzify-holiday-header__image"
                      src="{{ fallback_asset | asset_url }}"
                      width="{{ fallback_width }}"
                      height="{{ fallback_height }}"
                      loading="{{ image_loading }}"
                      alt="{{ card_alt | escape }}"
                    >
                  </picture>
                {%- else -%}
                  {{- 'lifestyle-1' | placeholder_svg_tag: 'nailzify-holiday-header__image placeholder' -}}
                {%- endif -%}

                {%- if block.settings.caption != blank -%}
                  <figcaption class="nailzify-holiday-header__caption">{{ block.settings.caption | escape }}</figcaption>
                {%- endif -%}

                {%- if block.settings.mobile_label != blank -%}
                  <span class="nailzify-holiday-header__mobile-label">{{ block.settings.mobile_label | escape | newline_to_br }}</span>
                {%- endif -%}
              </figure>

              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode -%}
        <div class="nailzify-holiday-header__empty">
          Add image cards to complete this header.
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nailzify holiday header",
  "tag": "section",
  "class": "nailzify-holiday-header-wrapper",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "A Little\nHoliday magic"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h1"
    },
    {
      "type": "checkbox",
      "id": "use_script_artwork",
      "label": "Use script heading artwork",
      "info": "Turn this off to display the editable heading text instead.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "heading_artwork",
      "label": "Custom heading artwork",
      "info": "Optional transparent image. The included holiday artwork is used when this is empty."
    },
    {
      "type": "text",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "Your finishing touch for every celebration."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP HOLIDAY NAILS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_external",
      "label": "Open button in a new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    },
    {
      "type": "text",
      "id": "gallery_label",
      "label": "Gallery accessibility label",
      "default": "Holiday nail designs"
    },
    {
      "type": "text",
      "id": "mobile_eyebrow",
      "label": "Mobile eyebrow",
      "default": "THE HOLIDAY EDIT"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Desktop content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Desktop text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Mobile text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_hero_card",
      "label": "Mobile hero image",
      "info": "Choose which image card becomes the full mobile campaign image.",
      "options": [
        { "value": "1", "label": "First image card" },
        { "value": "2", "label": "Second image card" },
        { "value": "3", "label": "Third image card" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_hand_slider",
      "label": "Enable mobile hand slider",
      "info": "Keeps the poster background and copy fixed while the selected hand images change.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_hand_slider",
      "label": "Use matching desktop hand banner",
      "info": "Shows the mobile hand rotation beside the copy on the shared poster background.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "mobile_slider_background_image",
      "label": "Mobile slider background image",
      "info": "Optional. The included warm studio background is used when this is empty."
    },
    {
      "type": "checkbox",
      "id": "mobile_slider_autoplay",
      "label": "Automatically change mobile hands",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_slider_delay",
      "label": "Seconds between mobile slides",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "mobile_poster_height",
      "label": "Mobile poster height",
      "min": 560,
      "max": 760,
      "step": 10,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Desktop minimum height",
      "min": 350,
      "max": 650,
      "step": 10,
      "unit": "px",
      "default": 430
    },
    {
      "type": "range",
      "id": "heading_width",
      "label": "Heading artwork width",
      "min": 300,
      "max": 680,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Editable heading size",
      "min": 40,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile editable heading size",
      "min": 36,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Desktop image height",
      "min": 280,
      "max": 500,
